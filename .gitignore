# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Bundle Outputs
dist/
dist/server.cjs
build/
server.js
coverage/

# Application Persistent Data & Uploads (NEVER commit user data to git!)
portal_shiraz_data/*
!portal_shiraz_data/.gitkeep
!portal_shiraz_data/backups/.gitkeep
!portal_shiraz_data/uploads/.gitkeep
data/*
!data/.gitkeep
!data/backups/.gitkeep
!data/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
backups/*
!backups/.gitkeep
database.json*
visits.json*
*.tmp
*.bak

# Environment Variables and Local Secrets
.env
.env.local
.env.*
.datadir

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and Editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
