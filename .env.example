# ==============================================================================
# Portal Shiraz / Homelab Dashboard - Standardized Offline Environment Config
# ==============================================================================

# Standardized Persistent Storage Directory (Container root)
DATA_DIR=/app/data

# System Timezone
TZ=Asia/Tehran

# Port Configuration
PORT=4500

# Node Runtime Environment
NODE_ENV=production

# JSON Web Token Secret Key for Session Authentication
JWT_SECRET=shiraz_portal_jwt_secret_token_2026

# Administrative Initial Bootstrap Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=123
RESET_ADMIN_PASSWORD=false
