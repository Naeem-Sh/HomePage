# ==============================================================================
# Homelab Portal (LinxDash) - Docker Environment Configuration
# فایل تنظیمات محیطی داکر - برای استفاده در سرور، این فایل را به .env تغییر نام دهید
# ==============================================================================

# Server Port / پورت وب‌سرور
PORT=3000

# Environment Mode / حالت اجرا
NODE_ENV=production

# Persistent Data Directory / مسیر ذخیره‌سازی داده‌های برنامه
DATA_DIR=/app/data

# JWT Secret Key / کلید امنیتی امضای توکن‌های ورود
JWT_SECRET=linxdash_super_secret_jwt_key_2026_production_change_me

# Initial Admin Credentials / اطلاعات اولیه ورود ادمین
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=123

# Emergency Admin Password Reset (true / false)
RESET_ADMIN_PASSWORD=false
